    },
    {
      "type": "equation",
      "content": "= \\sigma^2 \\frac{\\sum_{k=1}^n (X_k - \\bar{X})^2}{\\left(\\sum_{k=1}^n (X_k - \\bar{X})^2\\right)^2} = \\frac{\\sigma^2}{\\sum_{k=1}^n (X_k - \\bar{X})^2} = \\frac{\\sigma^2}{A}"
