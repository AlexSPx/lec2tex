    {
      "type": "equation",
      "content": "\\hat{\\beta}_{1} = b_{1} = \\sum_{k=1}^{n} c_{k} Y_{k}"
    },
    {
      "type": "equation",
      "content": "\\hat{\\beta}_{0} = b_{0} = \\sum_{k=1}^{n} \\left( \\frac{1}{n} - \\bar{X} c_{k} \\right) Y_{k}"
    },
    {
      "type": "equation",
      "content": "c_{k} = \\frac{X_{k} - \\bar{X}}{A}"
    },
    {
      "type": "equation",
      "content": "A = \\sum_{k=1}^{n} (X_{k} - \\bar{X})^{2}"
    },
    {
      "type": "equation",
      "content": "Y_{k} = \\beta_{0} + \\beta_{1} X_{k} + \\varepsilon_{k}"
    },
    {
      "type": "equation",
      "content": "E Y_{k} = \\beta_{0} + \\beta_{1} X_{k}"
    },
    {
      "type": "equation",
      "content": "D \\varepsilon_{k}"
    },
    {
      "type": "equation",
      "content": "b_{1} \\sim N\\left(\\beta_{1}; \\frac{\\sigma^{2}}{A}\\right)"
    },
    {
      "type": "equation",
      "content": "b_{0} \\sim N\\left(\\beta_{0}; \\sigma^{2} \\left(\\frac{1}{n} + \\frac{\\bar{X}^{2}}{A}\\right)\\right)"
    }
  ]
