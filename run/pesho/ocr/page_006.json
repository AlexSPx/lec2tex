{
 "items": [
  {
   "type": "equation",
   "content": "\\mathbb{P}\\left(\\bigcap_{i \\in M} A_i\\right) = \\prod_{i \\in M} \\mathbb{P}(A_i)"
  },
  {
   "type": "text",
   "content": "Деф/ Нека"
  },
  {
   "type": "equation",
   "content": "(\\Omega, \\mathcal{A}, \\mathbb{P})"
  },
  {
   "type": "text",
   "content": "е вер пр-во. Тогава"
  },
  {
   "type": "equation",
   "content": "H_1, H_2, \\dots, H_n"
  },
  {
   "type": "text",
   "content": "образуват пълна група от събития, ако"
  },
  {
   "type": "equation",
   "content": "\\{H_1, H_2, \\dots \\}"
  },
  {
   "type": "text",
   "content": "изброимо безкр."
  },
  {
   "type": "text",
   "content": "а)"
  },
  {
   "type": "equation",
   "content": "H_i \\in \\mathcal{A}, \\; i \\le n \\quad (H_i \\in \\mathcal{A}, \\; i \\ge 1)"
  },
  {
   "type": "text",
   "content": "б)"
  },
  {
   "type": "equation",
   "content": "\\bigcup_{i=1}^n H_i = \\Omega \\quad \\left(\\bigcup_{i=1}^\\infty H_i = \\Omega\\right)"
  },
  {
   "type": "equation",
   "content": "\\bigcup \\leftarrow"
  },
  {
   "type": "text",
   "content": "обединение на не прес. се"
  },
  {
   "type": "text",
   "content": "Теорема/ (Пълната вероятност) Нека"
  },
  {
   "type": "equation",
   "content": "(\\Omega, \\mathcal{A}, \\mathbb{P})"
  },
  {
   "type": "text",
   "content": "и нека"
  },
  {
   "type": "equation",
   "content": "H_1, \\dots, H_n"
  },
  {
   "type": "text",
   "content": "или"
  },
  {
   "type": "equation",
   "content": "(H_1, H_2, \\dots)"
  },
  {
   "type": "text",
   "content": "е пълна гр от събития. Нека"
  },
  {
   "type": "equation",
   "content": "A \\in \\mathcal{A}"
  },
  {
   "type": "text",
   "content": ". Тогава"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(A) = \\sum_{i=1}^{n(\\infty)} \\mathbb{P}(A \\cap H_i) = \\sum_{i=1}^{n(\\infty)} \\mathbb{P}(H_i) \\mathbb{P}(A | H_i)"
  },
  {
   "type": "text",
   "content": "с конвенцията, че"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(A | H_i) = 0"
  },
  {
   "type": "text",
   "content": ", ако"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(H_i) = 0"
  },
  {
   "type": "text",
   "content": "Д-во/"
  },
  {
   "type": "equation",
   "content": "A = A \\cap \\Omega = A \\cap \\bigcup_{i=1}^n H_i = \\bigcup_{i=1}^n A \\cap H_i"
  },
  {
   "type": "text",
   "content": ". То тогава"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(A) = \\sum_{i=1}^n \\mathbb{P}(A \\cap H_i) = \\sum_{i=1}^n \\mathbb{P}(H_i) \\mathbb{P}(A | H_i)"
  },
  {
   "type": "equation",
   "content": "\\square"
  },
  {
   "type": "text",
   "content": "Теорема/ (Бейс) Имаме"
  },
  {
   "type": "equation",
   "content": "H_1, \\dots, H_n \\quad (H_1, H_2, \\dots)"
  },
  {
   "type": "text",
   "content": ", които са пълна гр от събития в"
  },
  {
   "type": "equation",
   "content": "(\\Omega, \\mathcal{A}, \\mathbb{P})"
  },
  {
   "type": "text",
   "content": ". Нека"
  },
  {
   "type": "equation",
   "content": "A \\in \\mathcal{A}"
  },
  {
   "type": "text",
   "content": "и"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(A) > 0"
  },
  {
   "type": "text",
   "content": ". Тогава"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(H_k | A) = \\mathbb{P}(A | H_k) \\frac{\\mathbb{P}(H_k)}{\\mathbb{P}(A)} = \\frac{\\mathbb{P}(H_k) \\mathbb{P}(A | H_k)}{\\sum_i \\mathbb{P}(H_i) \\mathbb{P}(A | H_i)}"
  },
  {
   "type": "text",
   "content": "Д-во/"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(H_k | A)"
  },
  {
   "type": "text",
   "content": ","
  },
  {
   "type": "equation",
   "content": "1 \\le k \\le n \\quad (\\infty)"
  },
  {
   "type": "text",
   "content": ","
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(H_k | A) = \\frac{\\mathbb{P}(H_k \\cap A)}{\\mathbb{P}(A)} ="
  },
  {
   "type": "equation",
   "content": "= \\frac{\\mathbb{P}(H_k) \\mathbb{P}(A | H_k)}{\\mathbb{P}(A)}"
  },
  {
   "type": "text",
   "content": ","
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(A) = \\sum_{i=1}^{n(\\infty)} \\mathbb{P}(H_i) \\mathbb{P}(A | H_i)"
  },
  {
   "type": "equation",
   "content": "\\square"
  }
 ],
 "page": 6
