  {
   "type": "equation",
   "content": "A_{n,\\varepsilon} = \\{\\omega \\in \\Omega : |X_n(\\omega) - X(\\omega)| > \\varepsilon\\} = \\{|X_n - X| > \\varepsilon\\}"
  },
  {
   "type": "text",
   "content": "Деф 1 (сходимост по вероятност) Казваме, че"
  },
  {
   "type": "equation",
   "content": "X_n \\xrightarrow[n\\to\\infty]{\\mathbb{P}} X"
  },
  {
   "type": "text",
   "content": "ако"
  },
  {
   "type": "equation",
   "content": "\\forall \\varepsilon > 0"
  },
  {
   "type": "equation",
   "content": "\\lim_{n\\to\\infty} \\mathbb{P}(A_{n,\\varepsilon}) = 0"
  },
  {
   "type": "equation",
   "content": "\\varepsilon > \\delta"
  },
  {
   "type": "text",
   "content": "то"
  },
  {
   "type": "equation",
   "content": "A_{n,\\varepsilon} \\subseteq A_{n,\\delta}"
  },
  {
   "type": "text",
   "content": "Нека"
  },
  {
   "type": "equation",
   "content": "F_X"
  },
  {
   "type": "text",
   "content": "е ф-я на разпред. тогава"
  },
  {
   "type": "equation",
   "content": "C_{F_X} = \\{x \\in \\mathbb{R} : F \\text{ е непрек. в } x\\}"
  },
  {
   "type": "text",
   "content": "(за НСВ"
  },
  {
   "type": "equation",
   "content": "C_{F_X} = \\mathbb{R}"
  },
  {
   "type": "text",
   "content": ")"
  },
  {
   "type": "text",
   "content": "Деф 1 (сходимост по разпр.) Нека"
  },
  {
   "type": "equation",
   "content": "X_n"
  },
  {
   "type": "text",
   "content": "е сл. вел. в"
  },
  {
   "type": "equation",
   "content": "(\\Omega_n, \\mathcal{A}_n, \\mathbb{P}_n)_{n \\ge 1}"
  },
  {
   "type": "text",
   "content": "и нека"
  },
  {
   "type": "equation",
   "content": "X"
  },
  {
   "type": "text",
   "content": "е сл. вел. в"
  },
  {
   "type": "equation",
   "content": "(\\Omega, \\mathcal{A}, \\mathbb{P})"
  },
  {
   "type": "text",
   "content": ". Тогава"
  },
  {
   "type": "equation",
   "content": "X_n \\xrightarrow[n\\to\\infty]{d} X"
  },
  {
   "type": "text",
   "content": ", ако за всяко"
  },
  {
   "type": "equation",
   "content": "x \\in C_{F_X}"
  },
  {
   "type": "text",
   "content": "е вярно, че"
  },
  {
   "type": "equation",
   "content": "\\lim_{n\\to\\infty} F_{X_n}(x) = F_X(x)"
  },
  {
   "type": "text",
   "content": "(Може да се запише"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(X_n < x) \\xrightarrow[n\\to\\infty]{} \\mathbb{P}(X < x)"
  },
  {
   "type": "text",
   "content": ")"
  },
  {
   "type": "text",
   "content": "Теор 1."
  },
  {
   "type": "text",
   "content": "а)"
  },
  {
   "type": "equation",
   "content": "X_n \\xrightarrow[n\\to\\infty]{\\text{п.с.}} X"
  },
  {
   "type": "text",
   "content": ", то"
  },
  {
   "type": "equation",
   "content": "X_n \\xrightarrow[n\\to\\infty]{\\mathbb{P}} X"
  },
  {
   "type": "text",
   "content": "б)"
  },
  {
   "type": "equation",
   "content": "X_n \\xrightarrow[n\\to\\infty]{\\mathbb{P}} X"
  },
  {
   "type": "text",
   "content": ", то"
  },
  {
   "type": "equation",
   "content": "X_n \\xrightarrow[n\\to\\infty]{d} X"
  },
  {
   "type": "text",
   "content": "Д-во"
  },
  {
   "type": "text",
   "content": "а)"
  },
  {
   "type": "equation",
   "content": "L_X = \\{\\lim_{n\\to\\infty} X_n = X\\}"
  },
  {
   "type": "text",
   "content": ", знаем, че"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(L_X) = 1"
  },
  {
   "type": "text",
   "content": ". Знаем, че"
  },
  {
   "type": "equation",
   "content": "X_n \\xrightarrow[n\\to\\infty]{\\text{п.с.}} X"
  },
  {
   "type": "text",
   "content": "и искаме да пок., че"
  },
  {
   "type": "equation",
   "content": "\\forall \\varepsilon > 0"
  },
  {
   "type": "equation",
   "content": "\\lim_{n\\to\\infty} \\mathbb{P}(A_{n,\\varepsilon}) = 0"
  },
  {
   "type": "equation",
   "content": "A_{n,\\varepsilon} = \\{|X_n - X| > \\varepsilon\\}"
  },
  {
   "type": "equation",
   "content": "\\forall \\varepsilon = 1/r, r \\ge 1"
  },
  {
   "type": "equation",
   "content": "L_X = \\bigcap_{r=1}^\\infty \\bigcup_{n=1}^\\infty \\bigcap_{k=n}^\\infty A_{k,1/r}^c"
  },
  {
   "type": "text",
   "content": ", където"
  },
  {
   "type": "equation",
   "content": "A_{k,1/r}^c = \\{|X_k - X| \\le 1/r\\}"
  },
  {
   "type": "text",
   "content": "за всяко"
  },
  {
   "type": "equation",
   "content": "r"
  },
  {
   "type": "text",
   "content": ", същ"
  },
  {
   "type": "equation",
   "content": "n"
  },
  {
   "type": "text",
   "content": ", т.ч. за всяко"
  },
  {
   "type": "equation",
   "content": "k \\ge n"
  },
  {
   "type": "text",
   "content": "е изп."
  },
  {
   "type": "text",
   "content": "(сходимост)"
  },
  {
   "type": "equation",
   "content": "L_X^c = \\bigcup_{r=1}^\\infty \\underbrace{\\bigcap_{n=1}^\\infty \\underbrace{\\bigcup_{k=n}^\\infty A_{k,1/r}}_{C_{n,r}}}_{B_r}"
  },
  {
   "type": "text",
   "content": ","
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(L_X^c) = 0"
  },
  {
   "type": "text",
   "content": ","
  },
  {
   "type": "equation",
   "content": "L_X^c = \\bigcup_{r=1}^\\infty B_r"
  },
  {
   "type": "text",
   "content": ", то"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(B_r) = 0, \\forall r \\ge 1"
  },
  {
   "type": "text",
   "content": ", защото"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(\\bigcup_{r=1}^\\infty B_r) \\le \\sum_{r=1}^\\infty \\mathbb{P}(B_r)"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(\\bigcap_{n=1}^\\infty C_{n,r}) = 0 = \\lim_{n\\to\\infty} \\mathbb{P}(C_{n,r})"
  },
  {
   "type": "text",
   "content": ", защото"
  },
  {
   "type": "equation",
   "content": "C_{n,r} \\supseteq C_{n+1,r} \\supseteq \\dots"
  },
  {
   "type": "equation",
   "content": "C_{n,r} = \\bigcup_{k=n}^\\infty A_{k,1/r} \\supseteq A_{n,1/r}"
  },
  {
   "type": "text",
   "content": ", но"
  },
  {
   "type": "equation",
   "content": "\\mathbb{P}(\\bigcup_{k=n}^\\infty A_{k,1/r}) \\ge \\mathbb{P}(A_{n,1/r})"
  },
  {
   "type": "equation",
   "content": "(\\forall r)"
  },
  {
   "type": "equation",
   "content": "\\downarrow_{n\\to\\infty}"
  },
  {
   "type": "equation",
   "content": "0"
  },
  {
   "type": "equation",
   "content": "\\downarrow_{n\\to\\infty}"
  },
  {
   "type": "equation",
   "content": "0"
  }
