[
  {
    "start": 0.0,
    "end": 1.72,
    "text": "на А допълнение, то"
  },
  {
    "start": 1.72,
    "end": 4.08,
    "text": "Омега не принадлежи на А."
  },
  {
    "start": 5.16,
    "end": 6.54,
    "text": "Тоест, това е допълнението."
  },
  {
    "start": 6.6,
    "end": 8.72,
    "text": "Грубо казано, какво е вашето Омега."
  },
  {
    "start": 9.06,
    "end": 10.76,
    "text": "Много често така човек си го представя,"
  },
  {
    "start": 10.8,
    "end": 12.26,
    "text": "незвисимо доли е дискретно или не,"
  },
  {
    "start": 12.58,
    "end": 13.78,
    "text": "като някакво множество."
  },
  {
    "start": 14.52,
    "end": 16.0,
    "text": "И да кажем, това е вашето А."
  },
  {
    "start": 17.2,
    "end": 18.4,
    "text": "Това тук е"
  },
  {
    "start": 18.4,
    "end": 20.22,
    "text": "А допълнение."
  },
  {
    "start": 21.28,
    "end": 22.68,
    "text": "Омега в някакъв смисъл"
  },
  {
    "start": 22.68,
    "end": 24.8,
    "text": "е А, обединено с А"
  },
  {
    "start": 24.8,
    "end": 26.1,
    "text": "допълнение."
  },
  {
    "start": 26.84,
    "end": 28.54,
    "text": "И в примерите, които имахме,"
  },
  {
    "start": 28.62,
    "end": 29.76,
    "text": "да кажем за клиентите,"
  },
  {
    "start": 30.0,
    "end": 32.44,
    "text": "когато върнем събитието А, жени."
  },
  {
    "start": 32.9,
    "end": 34.16,
    "text": "Допълнението на А"
  },
  {
    "start": 34.16,
    "end": 35.7,
    "text": "ще бъде мъже."
  },
  {
    "start": 39.48,
    "end": 41.12,
    "text": "Това е да кажем"
  },
  {
    "start": 41.12,
    "end": 43.02,
    "text": "допълнението на множеството А,"
  },
  {
    "start": 43.16,
    "end": 45.02,
    "text": "когато върнем събитието А,"
  },
  {
    "start": 45.02,
    "end": 47.14,
    "text": "като събитието А"
  },
  {
    "start": 47.14,
    "end": 48.04,
    "text": "беше жени."
  },
  {
    "start": 51.04,
    "end": 52.62,
    "text": "Например, друго събитие,"
  },
  {
    "start": 52.7,
    "end": 54.8,
    "text": "допълнение е 2, 4, 6,"
  },
  {
    "start": 54.9,
    "end": 56.76,
    "text": "ако се върнем, например,"
  },
  {
    "start": 57.02,
    "end": 57.24,
    "text": "за"
  },
  {
    "start": 57.24,
    "end": 59.68,
    "text": "числата,"
  },
  {
    "start": 59.68,
    "end": 59.94,
    "text": "когато"
  },
  {
    "start": 59.94,
    "end": 61.52,
    "text": "да оттърваме на зарче."
  },
  {
    "start": 62.94,
    "end": 63.24,
    "text": "И"
  },
  {
    "start": 63.24,
    "end": 65.24,
    "text": "още един пример за допълнение."
  },
  {
    "start": 65.88,
    "end": 66.44,
    "text": "Може да бъде"
  },
  {
    "start": 66.44,
    "end": 66.94,
    "text": "на пример."
  },
  {
    "start": 67.72,
    "end": 68.54,
    "text": "Не гласували"
  },
  {
    "start": 68.54,
    "end": 69.42,
    "text": "за партия Х."
  },
  {
    "start": 69.42,
    "end": 76.2,
    "text": "Т.е."
  },
  {
    "start": 76.2,
    "end": 78.4,
    "text": "Ако имате някакъв признак,"
  },
  {
    "start": 79.32,
    "end": 80.74,
    "text": "по който определяте А,"
  },
  {
    "start": 81.2,
    "end": 82.46,
    "text": "то допълнението на А"
  },
  {
    "start": 82.46,
    "end": 83.8,
    "text": "са всички елементарни събития,"
  },
  {
    "start": 83.9,
    "end": 84.46,
    "text": "които не е"
  },
  {
    "start": 84.46,
    "end": 84.76,
    "text": "удобно."
  },
  {
    "start": 84.76,
    "end": 85.76,
    "text": "времето"
  },
  {
    "start": 85.76,
    "end": 85.82,
    "text": "върнем този признак."
  },
  {
    "start": 86.42,
    "end": 86.66,
    "text": "Т.е."
  },
  {
    "start": 86.66,
    "end": 87.2,
    "text": "които не са"
  },
  {
    "start": 87.2,
    "end": 87.56,
    "text": "жени,"
  },
  {
    "start": 88.46,
    "end": 89.16,
    "text": "които не са"
  },
  {
    "start": 89.16,
    "end": 90.0,
    "text": "гласувани за Х."
  },
  {
    "start": 90.0,
    "end": 91.18,
    "text": "и които не са"
  },
  {
    "start": 91.18,
    "end": 91.7,
    "text": "нечетни,"
  },
  {
    "start": 91.8,
    "end": 92.06,
    "text": "т.е."
  },
  {
    "start": 92.06,
    "end": 92.64,
    "text": "са четни."
  },
  {
    "start": 92.64,
    "end": 107.38,
    "text": "това са"
  },
  {
    "start": 107.38,
    "end": 108.76,
    "text": "тези операции,"
  },
  {
    "start": 108.84,
    "end": 109.72,
    "text": "за които ние имаме"
  },
  {
    "start": 109.72,
    "end": 111.38,
    "text": "възмегли,"
  },
  {
    "start": 111.7,
    "end": 112.08,
    "text": "т.е."
  },
  {
    "start": 112.08,
    "end": 114.36,
    "text": "вопълнение,"
  },
  {
    "start": 114.84,
    "end": 115.96,
    "text": "вънтрициалния пуската."
  },
  {
    "start": 120.36,
    "end": 121.0,
    "text": "И"
  },
  {
    "start": 121.0,
    "end": 123.94,
    "text": "това да видим"
  },
  {
    "start": 123.94,
    "end": 124.6,
    "text": "някой пример"
  },
  {
    "start": 124.6,
    "end": 125.44,
    "text": "да не пропусна."
  },
  {
    "start": 125.7,
    "end": 126.46,
    "text": "Мисля, че няма."
  },
  {
    "start": 126.6,
    "end": 127.32,
    "text": "Това горе-долу"
  },
  {
    "start": 127.32,
    "end": 128.54,
    "text": "съм го написал."
  },
  {
    "start": 129.02,
    "end": 129.94,
    "text": "И са някои други,"
  },
  {
    "start": 130.42,
    "end": 130.88,
    "text": "те са пак"
  },
  {
    "start": 130.88,
    "end": 131.92,
    "text": "кръстени операции,"
  },
  {
    "start": 132.86,
    "end": 133.7,
    "text": "с множество."
  },
  {
    "start": 134.36,
    "end": 135.02,
    "text": "Или по-скоро"
  },
  {
    "start": 135.02,
    "end": 135.62,
    "text": "свойство,"
  },
  {
    "start": 135.76,
    "end": 136.18,
    "text": "искате."
  },
  {
    "start": 136.74,
    "end": 137.02,
    "text": "Т.е."
  },
  {
    "start": 137.02,
    "end": 137.52,
    "text": "че ясен знам"
  },
  {
    "start": 137.52,
    "end": 138.38,
    "text": "как да го кръстам."
  },
  {
    "start": 141.52,
    "end": 142.32,
    "text": "Това е нещо,"
  },
  {
    "start": 142.56,
    "end": 143.14,
    "text": "повечето тях"
  },
  {
    "start": 143.14,
    "end": 144.2,
    "text": "са съвсем естествените,"
  },
  {
    "start": 144.32,
    "end": 145.08,
    "text": "с толкова тим няма,"
  },
  {
    "start": 145.14,
    "end": 146.38,
    "text": "че това може да го забравя."
  },
  {
    "start": 148.48,
    "end": 148.78,
    "text": "А,"
  },
  {
    "start": 148.88,
    "end": 149.92,
    "text": "угадименост Б"
  },
  {
    "start": 149.92,
    "end": 150.98,
    "text": "е всъщност Б,"
  },
  {
    "start": 150.98,
    "end": 152.32,
    "text": "обединено с А,"
  },
  {
    "start": 152.92,
    "end": 153.52,
    "text": "т.е. имате"
  },
  {
    "start": 153.52,
    "end": 153.86,
    "text": "някаква"
  },
  {
    "start": 153.86,
    "end": 154.76,
    "text": "коммунитативност."
  },
  {
    "start": 156.76,
    "end": 157.42,
    "text": "Имате"
  },
  {
    "start": 157.42,
    "end": 159.36,
    "text": "А сечено с Б"
  },
  {
    "start": 159.36,
    "end": 161.26,
    "text": "и всъщност Б сечено с А."
  },
  {
    "start": 166.92,
    "end": 168.04,
    "text": "Имате А"
  },
  {
    "start": 168.04,
    "end": 169.72,
    "text": "обединено с Б"
  },
  {
    "start": 169.72,
    "end": 171.12,
    "text": "обединено с С,"
  },
  {
    "start": 171.4,
    "end": 171.86,
    "text": "т.е. имате"
  },
  {
    "start": 171.86,
    "end": 172.7,
    "text": "три събития,"
  },
  {
    "start": 173.54,
    "end": 174.22,
    "text": "или А,"
  },
  {
    "start": 174.88,
    "end": 175.12,
    "text": "т.е."
  },
  {
    "start": 175.22,
    "end": 176.0,
    "text": "или Б,"
  },
  {
    "start": 176.14,
    "end": 176.64,
    "text": "или С,"
  },
  {
    "start": 177.38,
    "end": 178.14,
    "text": "и добавено"
  },
  {
    "start": 178.14,
    "end": 179.5,
    "text": "същото обединение с А,"
  },
  {
    "start": 179.5,
    "end": 179.86,
    "text": "тоже."
  },
  {
    "start": 179.86,
    "end": 209.84,
    "text": "Абонирайте се!"
  }
]