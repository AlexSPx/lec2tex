      "content": "ези / тура"
    },
    {
      "type": "text",
      "content": "Каква е вероятността от 10 хв. да имаме 6 езита?"
    },
    {
      "type": "equation",
      "content": "\\rightarrow P(\\dots) = \\binom{10}{6}\\left(\\frac{1}{2}\\right)^{10}"
    },
    {
      "type": "text",
      "content": "(Теорема)"
    },
    {
      "type": "text",
      "content": "Закон за гол. числа:"
    },
    {
      "type": "equation",
      "content": "\\frac{\\#\\text{езита}}{\\#\\text{хвърляния}} \\xrightarrow[\\text{хвърляния} \\to \\infty]{} \\frac{1}{2}"
    },
    {
      "type": "equation",
      "content": "X_1 = 1"
    },
    {
      "type": "text",
      "content": "за ези"
    },
    {
      "type": "equation",
      "content": "X_1 = 0"
    },
    {
      "type": "text",
      "content": "за тура"
    },
    {
      "type": "equation",
      "content": "\\frac{X_1 + \\dots + X_n}{n} \\xrightarrow[n \\to \\infty]{\\text{почти сигурно}} \\frac{1}{2}"
    }
  ]
