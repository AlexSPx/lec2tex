    {
      "type": "equation",
      "content": "\\Rightarrow G^*(Y) = \\frac{\\mathbb{E} X 1_A}{\\mathbb{P}(A)} 1_A + \\frac{\\mathbb{E} X 1_{A^c}}{\\mathbb{P}(A^c)} 1_{A^c} =: \\mathbb{E}(X|Y)"
    },
    {
