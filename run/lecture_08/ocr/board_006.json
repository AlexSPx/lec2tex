      "content": "0 = \\frac{\\partial f}{\\partial b} = 2b\\mathbb{P}(A^c) - 2\\mathbb{E}X1_{A^c}"
    },
    {
      "type": "equation",
      "content": "\\Rightarrow"
    },
    {
      "type": "equation",
      "content": "a = \\frac{\\mathbb{E}X1_A}{\\mathbb{P}(A)} = \\frac{\\mathbb{E}XY}{\\mathbb{P}(Y=1)}"
    },
    {
      "type": "equation",
      "content": "b = \\frac{\\mathbb{E}X1_{A^c}}{\\mathbb{P}(A^c)} = \\frac{\\mathbb{E}X(1-Y)}{\\mathbb{P}(Y=0)}"
    }
  ]
