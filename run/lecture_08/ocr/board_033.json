    {
      "type": "equation",
      "content": "\\oplus X \\sim Ber(Y)"
    },
    {
      "type": "equation",
      "content": "Y = \\begin{cases} \\frac{2}{3} & \\textcircled{p} \\\\ \\frac{1}{3} & 1-p \\end{cases}"
    },
    {
      "type": "equation",
      "content": "\\mathbb{E}[\\mathbb{E}[X|Y]] = \\frac{2}{3} \\cdot p + \\frac{1}{3} (1-p)"
    },
    {
      "type": "equation",
      "content": "\\mathbb{P}(X=1) = \\mathbb{E}X \\overset{\\cap}{=} \\mathbb{E}[\\mathbb{E}[X|Y]]"
    },
    {
      "type": "equation",
      "content": "\\mathbb{E}[X|Y] = \\frac{\\mathbb{E}[X \\mathbb{1}_{Y=\\frac{2}{3}}]}{\\mathbb{P}(Y=\\frac{2}{3})} \\mathbb{1}_{Y=\\frac{2}{3}} + \\frac{\\mathbb{E}[X \\mathbb{1}_{Y=\\frac{1}{3}}]}{\\mathbb{P}(Y=\\frac{1}{3})} \\mathbb{1}_{Y=\\frac{1}{3}}"
    },
    {
      "type": "equation",
      "content": "= \\mathbb{E}[X|Y=\\frac{2}{3}] \\mathbb{1}_{Y=\\frac{2}{3}} + \\mathbb{E}[X|Y=\\frac{1}{3}] \\mathbb{1}_{Y=\\frac{1}{3}}"
    },
    {
      "type": "equation",
      "content": "= \\frac{2}{3} \\mathbb{1}_{Y=\\frac{2}{3}} + \\frac{1}{3} \\mathbb{1}_{Y=\\frac{1}{3}}"
    }
  ]
