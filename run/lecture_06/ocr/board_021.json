      "content": "Д-во:"
    },
    {
      "type": "equation",
      "content": "n=2"
    },
    {
      "type": "equation",
      "content": "Y = X_1 + X_2;"
    },
    {
      "type": "equation",
      "content": "g_Y(s) = \\mathbb{E} s^{X_1+X_2} = \\sum_{j=0}^{\\infty} \\sum_{i=0}^{\\infty} s^{i+j} \\mathbb{P}(X_1=j; X_2=i)"
    },
    {
      "type": "equation",
      "content": "\\underline{\\underline{X_1 \\perp\\!\\!\\!\\perp X_2}}"
    },
    {
      "type": "equation",
      "content": "\\sum_{j=0}^{\\infty} \\sum_{i=0}^{\\infty} s^i s^j \\mathbb{P}(X_1=j) \\mathbb{P}(X_2=i) = \\sum_{j=0}^{\\infty} s^j \\mathbb{P}(X_1=j) \\sum_{i=0}^{\\infty} s^i \\mathbb{P}(X_2=i)"
    },
    {
      "type": "equation",
      "content": "= g_{X_1}(s) g_{X_2}(s)"
    },
    {
      "type": "text",
      "content": "Ако"
    },
    {
      "type": "equation",
      "content": "X_1 \\stackrel{d}{=} X_2"
    },
    {
      "type": "text",
      "content": ", то"
    },
    {
      "type": "equation",
      "content": "g_{X_1} = g_{X_2}"
    },
    {
      "type": "equation",
      "content": "\\Rightarrow g_Y(s) = (g_{X_1}(s))^2."
    }
  ]
}