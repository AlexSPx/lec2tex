  "items": [
    {
      "type": "text",
      "content": "Б. Биномно разпределение"
    },
    {
      "type": "text",
      "content": "Тв:"
    },
    {
      "type": "text",
      "content": "Нека"
    },
    {
      "type": "equation",
      "content": "X \\sim Bi(n, p)"
    },
    {
      "type": "text",
      "content": "а)"
    },
    {
      "type": "equation",
      "content": "g_X(s) = (q+ps)^n"
    },
    {
      "type": "text",
      "content": ";"
    },
    {
      "type": "text",
      "content": "б)"
    },
    {
      "type": "equation",
      "content": "\\mathbb{E}X = np"
    },
    {
      "type": "text",
      "content": ";"
    },
    {
      "type": "text",
      "content": "в)"
    },
    {
      "type": "equation",
      "content": "DX = npq"
    },
    {
      "type": "text",
      "content": "г)"
    },
    {
      "type": "equation",
      "content": "\\mathbb{P}(X=k) = \\binom{n}{k} p^k q^{n-k}"
    },
    {
      "type": "equation",
      "content": "0 \\le k \\le n"
    },
    {
      "type": "text",
      "content": "Д-во:"
    },
    {
      "type": "text",
      "content": "а)"
    },
    {
      "type": "equation",
      "content": "X = \\sum_{j=1}^n X_j \\xrightarrow{\\text{тв.}} g_X(s) = (g_{X_1}(s))^n = (q+ps)^n"
    },
    {
      "type": "text",
      "content": "б)"
    },
    {
      "type": "equation",
      "content": "\\mathbb{E}X = g_X'(1) = np(q+ps)^{n-1} \\Big|_{s=1} = np(p+q)^{n-1} = np"
    }
  ]
}