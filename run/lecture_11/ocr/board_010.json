      "content": "Тв.) Нека"
    },
    {
      "type": "equation",
      "content": "X \\sim N(\\mu, \\sigma^2)"
    },
    {
      "type": "text",
      "content": ". Тогава"
    },
    {
      "type": "equation",
      "content": "M_X(t) = e^{\\mu t} \\cdot M_Z(\\sigma t)"
    },
    {
      "type": "text",
      "content": ", където"
    },
    {
      "type": "equation",
      "content": "Z \\sim N(0, 1)"
    },
    {
      "type": "text",
      "content": "и"
    },
    {
      "type": "equation",
      "content": "M_X(t) = e^{\\mu t + \\frac{\\sigma^2}{2} t^2}"
    },
    {
      "type": "text",
      "content": ", т.е."
    },
    {
      "type": "equation",
      "content": "M_Z(t) = e^{\\frac{t^2}{2}}"
    },
    {
      "type": "text",
      "content": ";"
    },
    {
      "type": "text",
      "content": "Д-во:)"
    },
    {
      "type": "equation",
      "content": "X = \\mu + \\sigma Z \\Rightarrow M_X(t) \\stackrel{\\text{св.( )}}{=} e^{\\mu t} \\underline{M_Z(\\sigma t)}"
    },
    {
      "type": "equation",
      "content": "M_Z(s) = \\frac{1}{\\sqrt{2\\pi}} \\int_{-\\infty}^{\\infty} e^{sy} e^{-\\frac{y^2}{2}} dy"
    }
  ]
}