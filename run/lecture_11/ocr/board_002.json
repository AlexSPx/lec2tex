      "type": "text",
      "content": "с означението"
    },
    {
      "type": "equation",
      "content": "Z_n := \\frac{\\sqrt{n}}{\\sigma} E_n = \\frac{\\sqrt{n}}{\\sigma} \\left( \\frac{S_n}{n} - \\mu \\right) = \\frac{S_n - n\\mu}{\\sigma\\sqrt{n}}"
    },
    {
      "type": "text",
      "content": ", че"
    },
    {
      "type": "equation",
      "content": "Z_n \\xrightarrow[n\\to\\infty]{d} Z \\sim N(0,1)"
    },
