      "content": "Y=ax+b"
    },
    {
      "type": "text",
      "content": "Теор: Нека"
    },
    {
      "type": "equation",
      "content": "X"
    },
    {
      "type": "text",
      "content": "и"
    },
    {
      "type": "equation",
      "content": "Y"
    },
    {
      "type": "text",
      "content": "сл. вел. с"
    },
    {
      "type": "equation",
      "content": "DX < \\infty"
    },
    {
      "type": "text",
      "content": "и"
    },
    {
      "type": "equation",
      "content": "DY < \\infty."
    },
    {
      "type": "text",
      "content": "Тогава"
    },
    {
      "type": "equation",
      "content": "Y=ax+b \\iff |\\rho(X,Y)|=1."
    },
    {
      "type": "text",
      "content": "Д-во:"
    },
    {
      "type": "equation",
      "content": "\"\\Rightarrow\""
    },
    {
      "type": "equation",
      "content": "\\overline{Y} = v\\overline{X}"
    },
    {
      "type": "equation",
      "content": "1 \\stackrel{Th}{=} D\\overline{Y} = Dv\\overline{X} = v^2D\\overline{X} = v^2"
    },
    {
      "type": "equation",
      "content": "\\implies v^2=1"
    },
    {
      "type": "text",
      "content": "или"
    },
    {
      "type": "equation",
      "content": "v=\\pm 1"
    },
    {
      "type": "equation",
      "content": "\\overline{Y} = \\pm \\overline{X}"
    },
    {
      "type": "equation",
      "content": "\\longrightarrow \\overline{Y} = \\overline{X} \\implies \\overline{X}\\overline{Y} = \\overline{X}^2"
    },
    {
      "type": "equation",
      "content": "\\rho(X,Y) = E\\overline{X}\\overline{Y} = E\\overline{X}^2 = 1"
    },
    {
      "type": "equation",
      "content": "\\longrightarrow \\overline{Y} = -\\overline{X} \\implies"
    },
    {
      "type": "equation",
      "content": "1 = E\\overline{Y}^2 = -E\\overline{X}\\overline{Y} = -\\rho(X,Y)"
    },
    {
      "type": "equation",
      "content": "\\implies \\rho(X,Y) = -1."
    }
  ]
}